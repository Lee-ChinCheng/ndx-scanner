# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# OpenRouter API key for the LLM commentary (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# SMTP sender account used by scanner/notifier.py
# For Gmail use an App Password (not your login password); spaces are stripped automatically.
EVAS_EMAIL=
EVAS_PASSWORD=

# Report recipients, comma-separated. Overrides config.json notify.recipients.
NOTIFY_RECIPIENTS=

# Optional: FRED API key for macro series (scanner/fetchers.py)
FRED_API_KEY=
